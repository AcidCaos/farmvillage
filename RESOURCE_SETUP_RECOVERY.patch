+"""Loopback host lifecycle checks use fake game modules and new synthetic data."""
+from __future__ import annotations
+import fcntl
+import json
+import os
+from pathlib import Path
+import re
+import selectors
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import textwrap
+import time
+import unittest
+from urllib.error import HTTPError
+from urllib.parse import urlencode
+from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener
+HERE=Path(__file__).resolve().parent
+HOST_SCRIPT=HERE/'local_game_host.py'
+SERVER_FIXTURE='''
+import json
+import os
+from pathlib import Path
+from flask import Flask,jsonify,redirect,request
+from assets import check_assets
+check_assets()
+app=Flask(__name__)
+TEMPLATES_DIR=str(Path(__file__).parent/'templates')
+PROFILE=Path(os.environ['FARMVILLAGE_DATA_DIR'])
+@app.get('/')
+def home():return 'Synthetic farm gate'
+@app.post('/new.html')
+def create():
+    (PROFILE/'synthetic-farm.json').write_text(json.dumps({'name':request.form['name']}))
+    return redirect('/play.html')
+@app.get('/play.html')
+def legacy():return 'Legacy Flash object: host must redirect this route'
+@app.get('/ruffle.html')
+def modern():return '<html><script src="/ruffle/ruffle.js"></script><p>Modern synthetic Ruffle document</p></html>'
+@app.get('/proxy')
+def forbidden_proxy():raise AssertionError('Host must block before this endpoint executes')
+@app.get('/fixture/state')
+def state():
+    farm=PROFILE/'synthetic-farm.json'
+    return jsonify(ruffleOverride=os.environ.get('FARMVILLAGE_RUFFLE_DIR'),dataDir=str(PROFILE),assetsDir=os.environ.get('FARMVILLAGE_ASSETS_DIR'),native=os.environ.get('FARMVILLAGE_NATIVE'),farm=json.loads(farm.read_text()) if farm.is_file() else None)
+'''
+ADAPTER_FIXTURE='''
+def register_god_barn(app,*,game_server,player_module,bundle_module,farming_module,root):
+    @app.get('/god-barn/fixture')
+    def fixture_barn():return {'mounted':True,'rootName':root.name}
+'''
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self,request,response,code,message,headers,newurl):return None
+
+class PublicHostLoopbackTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary=tempfile.TemporaryDirectory(prefix='.public-host-test-',dir=HERE.parent)
+        self.base=Path(self.temporary.name).resolve()
+        self.addCleanup(self.temporary.cleanup)
+        (self.base/'.resources.lock').touch()
+        self.runtime=self.base/'Runtime';self.assets=self.base/'original-assets';self.data=self.base/'new-profile';self.home=self.base/'tool-home'
+        self.home.mkdir();(self.runtime/'templates').mkdir(parents=True);(self.runtime/'GodBarn').mkdir()
+        for name in ('Environment','xpromoSupport'):(self.assets/name).mkdir(parents=True)
+        (self.runtime/'server.py').write_text(textwrap.dedent(SERVER_FIXTURE))
+        (self.runtime/'assets.py').write_text('def check_assets():\n    raise AssertionError("Host must use prevalidated resources")\n')
+        (self.runtime/'GodBarn/__init__.py').write_text('')
+        (self.runtime/'GodBarn/integration.py').write_text(textwrap.dedent(ADAPTER_FIXTURE))
+        for name in ('player.py','bundle.py','barn_actions.py'):(self.runtime/name).write_text('"""Synthetic module: no player inputs."""\n')
+        self.children=[];self.addCleanup(self.stop_all)
+        self.opener=build_opener(ProxyHandler({}),NoRedirect())
+    def launch(self,*,wait_ready=True):
+        command=[sys.executable,'-I','-B',str(HOST_SCRIPT),'--runtime',str(self.runtime),'--assets',str(self.assets),'--data-dir',str(self.data),'--port','0','--no-browser']
+        env={'PATH':os.defpath,'HOME':str(self.home),'PYTHONDONTWRITEBYTECODE':'1','FARMVILLAGE_RUFFLE_DIR':str(self.base/'must-not-use-this-player')}
+        process=subprocess.Popen(command,cwd=self.base,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,start_new_session=True)
+        self.children.append(process)
+        print('[synthetic-public-host] owned PID '+str(process.pid),flush=True)
+        if not wait_ready:return process,None
+        deadline=time.monotonic()+20;output=[]
+        with selectors.DefaultSelector() as selector:
+            selector.register(process.stdout,selectors.EVENT_READ)
+            while time.monotonic()<deadline:
+                if selector.select(timeout=min(.5,max(0,deadline-time.monotonic()))):
+                    line=process.stdout.readline()
+                    if line:
+                        output.append(line);match=re.search(r'Ready\. Open (http://127\.0\.0\.1:\d+)/',line)
+                        if match:return process,match.group(1)
+                if process.poll() is not None:
+                    output.append(process.stdout.read());self.fail('Synthetic host exited before readiness:\n'+''.join(output))
+        self.fail('Synthetic host did not become ready:\n'+''.join(output))
+    def stop(self,process,*,assert_clean=False):
+        if process.poll() is None:
+            process.send_signal(signal.SIGTERM)
+            try:process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid,signal.SIGKILL);process.wait(timeout=5)
+                if assert_clean:self.fail('Owned synthetic host did not stop after SIGTERM')
+        output=process.stdout.read() if process.stdout is not None and not process.stdout.closed else ''
+        if process.stdout is not None:process.stdout.close()
+        if assert_clean:self.assertEqual(process.returncode,0,output)
+        return output
+    def stop_all(self):
+        for process in self.children:self.stop(process)
+    def request(self,origin,path,*,method='GET',data=None,headers=None):
+        request=Request(origin+path,data=urlencode(data).encode() if data is not None else None,method=method,headers=headers or {})
+        try:response=self.opener.open(request,timeout=5)
+        except HTTPError as failure:response=failure
+        with response:return response.status,dict(response.headers),response.read()
+    def test_first_new_farm_enters_modern_ruffle_and_companion_adapter_mounts(self):
+        process,origin=self.launch()
+        code,headers,_=self.request(origin,'/new.html',method='POST',data={'name':'Synthetic Farmer'},headers={'Origin':origin})
+        self.assertEqual(code,302);self.assertEqual(headers['Location'],'/play.html')
+        code,headers,_=self.request(origin,headers['Location'])
+        self.assertEqual(code,302);self.assertEqual(headers['Location'],'/ruffle.html')
+        code,_,body=self.request(origin,headers['Location'])
+        self.assertEqual(code,200);self.assertIn(b'/ruffle/ruffle.js',body);self.assertNotIn(b'Legacy Flash object',body)
+        code,_,body=self.request(origin,'/god-barn/fixture')
+        self.assertEqual(code,200);self.assertEqual(json.loads(body),{'mounted':True,'rootName':'GodBarn'})
+        self.stop(process,assert_clean=True)
+    def test_inherited_player_override_is_cleared_and_profile_paths_are_explicit(self):
+        process,origin=self.launch();code,_,body=self.request(origin,'/fixture/state')
+        self.assertEqual(code,200);state=json.loads(body)
+        self.assertIsNone(state['ruffleOverride']);self.assertEqual(state['dataDir'],str(self.data));self.assertEqual(state['assetsDir'],str(self.assets));self.assertEqual(state['native'],'0')
+        self.stop(process,assert_clean=True)
+    def test_remote_proxy_route_is_blocked_before_fake_game_endpoint(self):
+        process,origin=self.launch();code,_,body=self.request(origin,'/proxy')
+        self.assertEqual(code,404);self.assertIn(b'unavailable',body);self.stop(process,assert_clean=True)
